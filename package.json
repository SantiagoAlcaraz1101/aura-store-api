{
  "name": "aura-store-api",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/interface/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/interface/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx src/infrastructure/prisma/seed.ts",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "prisma": {
    "schema": "src/infrastructure/prisma/schema.prisma",
    "seed": "tsx src/infrastructure/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "prisma": "6.19.3",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
